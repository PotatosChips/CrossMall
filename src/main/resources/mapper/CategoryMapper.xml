<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="edu.cafuc.crossmall.mapper.CategoryMapper">

    <!-- 查询所有分类（按 sort 升序），用于首页/商品列表页的分类导航 -->
    <select id="selectAllCategories" resultType="Category">
        SELECT id, category_name, sort, create_time
        FROM category
        ORDER BY sort ASC
    </select>

    <!-- 根据分类 id 查询分类名称 -->
    <select id="selectCategoryNameById" parameterType="Long" resultType="String">
        SELECT category_name
        FROM category
        WHERE id = #{id}
    </select>

    <!-- 根据分类名称查询分类 id -->
    <select id="selectCategoryIdByName" parameterType="String" resultType="Long">
        SELECT id
        FROM category
        WHERE category_name = #{categoryName}
    </select>

</mapper>
