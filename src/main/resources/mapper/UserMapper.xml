<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="edu.cafuc.crossmall.mapper.UserMapper">
    <select id="selectUserByNameAndPassword" resultType="User">
        select * from user where username = #{username} and password = #{password}
    </select>
    <select id="selectUserByName" resultType="Integer">
        select count(*) from user where username = #{username}
    </select>

    <insert id="insertUser" parameterType="User" useGeneratedKeys="true" keyProperty="id">
        insert into user
            (username,password,nickname,phone,role,status)
            values (#{username},#{password},#{nickname},#{phone},#{role},#{status})
    </insert>
</mapper>