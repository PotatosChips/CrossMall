<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="edu.cafuc.crossmall.mapper.CartMapper">

    <!-- 加入购物车 -->
    <insert id="insertCart" useGeneratedKeys="true" keyProperty="id">
        insert into cart (user_id, product_id, quantity)
        values (#{userId}, #{productId}, #{quantity})
    </insert>

    <!-- 加购前判断是否已有该商品 -->
    <select id="selectByUserIdAndProductId" resultType="Cart">
        select * from cart
        where user_id = #{userId} and product_id = #{productId}
    </select>

    <!-- 根据 id 更新数量 -->
    <update id="updateCartById">
        update cart
        set quantity = #{quantity}
        where id = #{id} and user_id = #{userId}
    </update>

    <!-- 根据 id 删除购物车项 -->
    <delete id="deleteCartById">
        delete from cart
        where id = #{id} and user_id = #{userId}
    </delete>

    <!-- 根据 id 删除购物车项 -->
    <delete id="deleteCartByUserId">
        delete from cart
        where user_id = #{userId}
    </delete>

    <!-- 查询某用户的购物车列表 -->
    <select id="selectCartByUserId" resultType="Cart">
        select * from cart where user_id = #{userId}
    </select>

</mapper>
