<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="edu.cafuc.crossmall.mapper.CartMapper">

    <!-- TODO: 加入购物车，表名 cart -->
    <insert id="insertCart" parameterType="Cart" useGeneratedKeys="true" keyProperty="id">
    </insert>

    <!-- TODO: 根据 id 查询购物车项 -->
    <select id="selectCartById" parameterType="Long" resultType="Cart">
    </select>

    <!-- TODO: 更新购物车项（如改数量） -->
    <update id="updateCart" parameterType="Cart">
    </update>

    <!-- TODO: 根据 id 删除购物车项 -->
    <delete id="deleteCartById" parameterType="Long">
    </delete>

    <!-- TODO: 查询某用户的购物车列表 -->
    <select id="selectCartByUserId" parameterType="Long" resultType="Cart">
    </select>

</mapper>
