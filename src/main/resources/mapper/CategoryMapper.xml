<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="edu.cafuc.crossmall.mapper.CategoryMapper">

    <!-- 查询所有分类（按 sort 升序），用于首页/商品列表页的分类导航 -->
    <select id="selectAllCategories" resultType="Category">
        SELECT id, category_name, sort, create_time
        FROM category
        ORDER BY sort ASC
    </select>

    <!-- 根据分类 id 查询分类名称 -->
    <select id="selectCategoryNameById" parameterType="Long" resultType="String">
        SELECT category_name
        FROM category
        WHERE id = #{id}
    </select>

    <!-- 根据分类名称查询分类 id -->
    <select id="selectCategoryIdByName" parameterType="String" resultType="Long">
        SELECT id
        FROM category
        WHERE category_name = #{categoryName}
    </select>

    <!-- 统计分类个数 -->
    <select id="countCategories" resultType="Integer">
        SELECT COUNT(*)
        FROM category
    </select>

    <select id="selectById" resultType="Category">
        SELECT id, category_name, sort, create_time
        FROM category
        WHERE id = #{id}
    </select>

    <select id="countByCategoryName" resultType="Integer">
        SELECT COUNT(*)
        FROM category
        WHERE category_name = #{categoryName}
        <if test="excludeId != null">
            AND id != #{excludeId}
        </if>
    </select>

    <insert id="insertCategory" parameterType="Category" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO category (category_name, sort)
        VALUES (#{categoryName}, #{sort})
    </insert>

    <update id="updateCategory" parameterType="Category">
        UPDATE category
        SET category_name = #{categoryName},
            sort          = #{sort}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM category WHERE id = #{id}
    </delete>

</mapper>
