<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="edu.cafuc.crossmall.mapper.OrderItemMapper">

    <!-- 插入订单明细（多 @Param 入参，无需回填自增 id） -->
    <insert id="insertOrderItem">
        insert into order_item
            (order_id, product_id, product_name, price, quantity)
            values (#{orderId}, #{productId}, #{productName}, #{price}, #{quantity})
    </insert>

    <!-- TODO: 更新订单明细 -->
    <update id="updateOrderItem" parameterType="OrderItem">
    </update>

    <!-- 根据 id 删除订单明细 -->
    <delete id="deleteOrderItemById" parameterType="Long">
        DELETE from order_item
               where order_id = #{orderId}
    </delete>

    <!-- 根据查询订单所有明细 卖家-->
    <select id="selectOrderItemForSeller" resultType="OrderItem">
        select oi.*
        from order_item oi
                 inner join product p      -- 关联商品表
                            on p.id = oi.product_id  -- 商品ID = 明细里的商品ID
                 inner join merchant m     -- 关联商家表
                            on m.id = p.merchant_id  -- 商家ID = 商品所属商家
        where
            oi.order_id = #{orderId}
          and m.user_id = #{userId}  -- 关键：只查属于【当前商家】的订单
        ORDER BY oi.id DESC
    </select>

    <!-- 查询某订单下的所有明细 买家-->
    <select id="selectOrderItemByOrderId" parameterType="Long" resultType="OrderItem">
        select * from order_item
            where order_id = #{orderId}
    </select>

</mapper>
